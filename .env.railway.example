# Template ONLY: supply real values in Railway service Variables, not GitHub.
# DISCORD_TOKEN is a secret; NEVER place the real value in this file.
DISCORD_TOKEN=YOUR_PRIVATE_DISCORD_TOKEN
SNOWFALL_GUILD_ID=YOUR_DISCORD_SERVER_ID
SNOWFALL_ADMIN_USER_IDS=YOUR_DISCORD_USER_ID
# Optional: comma-separated Discord user/role IDs; separate by commas only.
SNOWFALL_STAFF_ROLE_IDS=
SNOWFALL_ANNOUNCEMENT_CHANNEL_ID=0
SNOWFALL_LEADERBOARD_CHANNEL_ID=0
SNOWFALL_STARTS_AT_UTC=2026-12-20T19:00:00+00:00
SNOWFALL_SEASON_KEY=christmas-2026
SNOWFALL_EVENT_NAME=Operation Snowfall
# Railway adds RAILWAY_VOLUME_MOUNT_PATH automatically after mounting /data.
# Do not set SNOWFALL_DATA_DIR to an ephemeral location on Railway.

# v2.9.2 defaults to SQLite. Change only after offline migration and verification.
SNOWFALL_DB_BACKEND=sqlite
# For postgresql ONLY, define SNOWFALL_DATABASE_URL as a private Railway
# reference to the separate Snowfall PostgreSQL service's DATABASE_URL.

# v2.9.4b — OPTIONAL, TESTING ONLY. Do not enable on the existing worker until
# the QA database and existing Discord OAuth integration have been verified.
# The same original bot token and guild are reused; no separate QA bot token.
# SNOWFALL_SHARED_MODE=qa
# SNOWFALL_DB_BACKEND=postgres
# SNOWFALL_SEASON_KEY=web-qa-2026
# SNOWFALL_DATABASE_URL=PRIVATE_URL_TO_ISOLATED_snowfall_web_qa_DATABASE
