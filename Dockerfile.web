# Optional standalone Snowfall API; deploy separately from the Discord worker.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN python -m pip install --no-cache-dir ".[postgres,web]"
# Staging-only web runtime. It refuses an incorrect Railway project/environment or missing approval.
CMD ["python", "-m", "snowfall.platform.staging_web"]
