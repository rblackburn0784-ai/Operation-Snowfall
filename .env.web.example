# Optional staging WEB service ONLY; never paste secrets in GitHub.
SNOWFALL_API_ENABLED=0
SNOWFALL_DB_BACKEND=postgres
SNOWFALL_DATABASE_URL=SET_PRIVATE_RAILWAY_POSTGRES_URL
SNOWFALL_API_SEASON_KEY=your-staging-season
SNOWFALL_WEB_PUBLIC_BASE_URL=https://your-staging-api.example
# Used by existing Underworld server to sign backend assertions; never expose in browser.
SNOWFALL_UNDERWORLD_ASSERTION_SECRET=SET_PRIVATE_RANDOM_SECRET_32_BYTES_MIN
# Discord OAuth identify scope, optional until ready to link accounts.
SNOWFALL_DISCORD_OAUTH_CLIENT_ID=
SNOWFALL_DISCORD_OAUTH_CLIENT_SECRET=
SNOWFALL_DISCORD_OAUTH_REDIRECT_URI=
# Optional allowlisted origins only; no wildcard. Use same-origin frontend by default.
SNOWFALL_WEB_ALLOWED_ORIGINS=
# Local development only (not Railway):
# SNOWFALL_ALLOW_INSECURE_LOCALHOST=1
# SNOWFALL_WEB_PUBLIC_BASE_URL=http://localhost:8080
